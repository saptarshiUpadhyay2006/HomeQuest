<!-- Custom Toast Notifications Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <% if(success && success.length){ %>
        <div class="custom-toast success-toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body d-flex align-items-center gap-3">
                <i class="fa-solid fa-circle-check toast-icon"></i>
                <div class="toast-content"><%= success %></div>
                <button type="button" class="btn-close toast-close-btn" onclick="this.closest('.custom-toast').classList.remove('show')"></button>
            </div>
            <div class="toast-progress"></div>
        </div>
    <% } %>

    <% if(error && error.length){ %>
        <div class="custom-toast error-toast show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body d-flex align-items-center gap-3">
                <i class="fa-solid fa-circle-exclamation toast-icon"></i>
                <div class="toast-content"><%= error %></div>
                <button type="button" class="btn-close toast-close-btn" onclick="this.closest('.custom-toast').classList.remove('show')"></button>
            </div>
            <div class="toast-progress"></div>
        </div>
    <% } %>
</div>