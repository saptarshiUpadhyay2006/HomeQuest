<% layout("/layouts/boilerplate") -%>
<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 12rem);
    }
    .auth-card {
        background: var(--glass-bg);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid var(--glass-border);
        border-radius: 2rem;
        padding: 3.5rem 3rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        width: 100%;
        max-width: 450px;
    }
    .auth-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
        border-color: rgba(227, 73, 73, 0.2);
    }
    .auth-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 2.4rem;
        color: var(--text-color);
        letter-spacing: -1px;
    }
    .form-control-custom {
        border-radius: 1rem;
        padding: 0.9rem 1.3rem;
        border: 1px solid var(--border-color);
        background-color: var(--bg-color) !important;
        color: var(--text-color) !important;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .form-control-custom:focus {
        border-color: #e34949 !important;
        box-shadow: 0 0 0 0.25rem rgba(227, 73, 73, 0.15) !important;
        transform: scale(1.01);
    }
    .form-label {
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0.6rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }
    .btn-auth {
        background: linear-gradient(135deg, #e34949 0%, #ff4b4b 100%);
        border: none;
        color: white !important;
        border-radius: 1rem;
        padding: 1rem;
        font-weight: 800;
        font-size: 1.1rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 8px 25px rgba(227, 73, 73, 0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-auth:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 12px 30px rgba(227, 73, 73, 0.5);
    }
    .btn-auth:active {
        transform: translateY(1px);
    }
    .divider-container {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 2rem 0;
    }
    .divider-line {
        flex: 1;
        height: 1px;
        background-color: var(--border-color);
    }
    .divider-text {
        padding: 0 1rem;
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-social {
        background: var(--bg-color);
        color: var(--text-color);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        padding: 0.9rem;
        font-weight: 700;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .btn-social:hover {
        background: rgba(227, 73, 73, 0.05);
        border-color: #e34949;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }
    .btn-social i {
        font-size: 1.2rem;
    }
</style>

<div class="auth-container mt-4 mb-5">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h1 class="auth-title mb-2">Welcome Back</h1>
            <p class="text-muted small">Explore your next stay with HomeQuest</p>
        </div>
        
        <!-- Social Sign In Options -->
        <div class="d-flex flex-column">
            <a href="/auth/google" class="btn btn-social text-decoration-none">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="18px" height="18px" viewBox="0 0 48 48" class="me-2" style="display: inline-block; vertical-align: middle;">
                    <g>
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                        <path fill="#4285F4" d="M46.5 24c0-1.61-.15-3.16-.42-4.69H24v8.87h12.66c-.55 2.94-2.2 5.43-4.69 7.11l7.3 5.66C43.5 36.43 46.5 30.87 46.5 24z"></path>
                        <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"></path>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.3-5.66c-2.2 1.47-5 2.35-8.59 2.35-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                        <path fill="none" d="M0 0h48v48H0z"></path>
                    </g>
                </svg>
                Continue with Google
            </a>
            <a href="/auth/google" class="btn btn-social text-decoration-none">
                <i class="fa-brands fa-github me-2"></i>
                Continue with GitHub
            </a>
        </div>
        
        <div class="divider-container">
            <div class="divider-line"></div>
            <div class="divider-text">or</div>
            <div class="divider-line"></div>
        </div>
        
        <!-- Local Sign In Form -->
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" 
                       id="username"
                       type="text"
                       class="form-control form-control-custom"
                       placeholder="Enter your username"
                       required>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>
            
            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input name="password" 
                       id="password"
                       type="password"
                       class="form-control form-control-custom"
                       placeholder="Enter your password"
                       required>
                <div class="invalid-feedback">Please enter your password.</div>
            </div>
            
            <button class="btn btn-auth w-100 mt-2">Sign In</button>
            
            <div class="text-center mt-4">
                <p class="text-muted mb-0 small">Don't have an account? <a href="/signup" class="text-decoration-none" style="color: #e34949; font-weight: 700;">Create account</a></p>
            </div>
        </form>
    </div>
</div>